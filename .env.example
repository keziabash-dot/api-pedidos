# Opcional: copie para ".env" para sobrescrever os valores padrão do docker-compose.yml.
# Sem o arquivo .env, os valores abaixo já são usados como padrão.
# Evite caracteres especiais (@ : / #) na senha, pois ela compõe a DATABASE_URL.
POSTGRES_USER=pedidos
POSTGRES_PASSWORD=pedidos
POSTGRES_DB=pedidos
